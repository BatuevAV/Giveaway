# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=sqlite+aiosqlite:///giveaway.db

# Owner ID (главный администратор, имеет все права)
OWNER_ID=your_telegram_id_here

# Admin IDs (comma separated, дополнительные администраторы)
ADMIN_IDS=123456789,987654321

# Ollama AI assistant (automatic giveaway draft generation)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45
